# Frontend environment variables
# Vite exposes only variables prefixed with VITE_

# URL of the FastAPI backend
VITE_API_URL=http://localhost:8000

# Predict API contract: v2 (item-schema, default) or v1 (bare PredictionResult)
# Rollback: set VITE_API_VERSION=v1 and rebuild / restart Vite
VITE_API_VERSION=v2
