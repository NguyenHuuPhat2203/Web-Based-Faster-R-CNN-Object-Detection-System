FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /install
COPY backend/requirements.txt .

# Use pip cache mount for faster rebuilds; strip dev artifacts
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.txt

# ── Runtime stage ─────────────────────────────────────────────────
# Thin image: no baked model weights. Mount ./registry and ./checkpoints at runtime.
# Tree mirrors the host: /app/backend + /app/ml with PYTHONPATH=/app.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS runtime

# Runtime system deps only (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Security: run as non-root
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app

WORKDIR /app

# Copy installed packages from builder (avoids leaving pip/build deps)
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Host-like layout (cwd-equivalent via PYTHONPATH=/app)
COPY backend/ /app/backend/
COPY ml/ /app/ml/
RUN rm -rf /app/backend/tests/ \
    && test -f /app/ml/__init__.py \
    && test -f /app/backend/main.py \
    && SECRET_KEY=build-time-import-check-only-not-a-real-secret \
       PYTHONPATH=/app python -c "import ml; import backend.main"

# Mount points for host volumes (weights are not baked into the image) and
# writable dirs for the compose `db` / `uploads` named volumes.
RUN mkdir -p /checkpoints /registry /app/db /app/uploads \
    && chown -R app:app /checkpoints /registry /app

# Production settings
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    CHECKPOINT_DIR=/checkpoints \
    REGISTRY_DIR=/registry

EXPOSE 8000

USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz')" || exit 1

CMD ["sh", "-c", "alembic -c /app/backend/alembic.ini upgrade head && uvicorn backend.main:app --host 0.0.0.0 --port 8000"]
