# ── Build stage ────────────────────────────────────────────────────
ARG NODE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

FROM $NODE_IMAGE AS build

WORKDIR /app

# Dependency installation (cache-friendly: code changes don't invalidate this layer)
COPY frontend/package.json frontend/package-lock.json ./
# Build needs devDependencies (vite, typescript); only dist/ ships.
RUN npm ci && npm cache clean --force

# Build the app — VITE_* vars are baked in at build time
COPY frontend/ .
ARG VITE_API_URL=http://localhost:8000
ARG VITE_API_VERSION=v2
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_VERSION=$VITE_API_VERSION
RUN npm run build

# ── Serve stage ───────────────────────────────────────────────────
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Custom nginx config: gzip, caching headers, SPA fallback, API proxy
RUN <<'EOF'
cat > /etc/nginx/conf.d/default.conf <<'NGINX'
server {
    listen       80;
    server_name  localhost;
    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1000;

    # Cache static assets with fingerprint in filename
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback — serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
NGINX
EOF

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
