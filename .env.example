# Hugging Face settings for scripts/sync_models.py.
# Copy to .env (gitignored, never committed) and fill in.

# Access token from https://huggingface.co/settings/tokens
# (write access to push weights; read access is enough to pull).
HF_TOKEN=

# Model repo that stores the weights, for example <user>/brain-tumor-models.
HF_MODEL_REPO_ID=
